<h1><%= title %></h1>
<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<div class="delete-vehicle-panel">
    
    <form id="deleteForm" method="POST" action="/inv/delete/">
        <p>Confirm Deletion - The delete is permanent.</p>
        <br>
        <label for = "inv_make">Make</label>
        <br>
        <input type="text" id="inv_make" name="inv_make" required value="<%= locals.inv_make %>" readonly>
        <br>
        <label for = "inv_model">Model</label>
        <br>
        <input type="text" id="inv_model" name="inv_model" required value="<%= locals.inv_model %>" readonly>
        <br>
        <label for = "inv_year">Year</label>
        <br>
        <input type="number" id="inv_year" name="inv_year" required value="<%= locals.inv_year %>" readonly>
        <br>
        <button type="submit">Delete Vehicle</button>
        <input type="hidden" name="inv_id"
        <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
        <% } %>>
    </form>  
</div>